---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FeaturedBrands from "../../../components/FeaturedBrands.astro";
import { getOtherBrands } from "../../../lib/brands";
import { designPaths } from "../../../lib/design";

export const getStaticPaths = designPaths;
const { design } = Astro.params;
const otherBrands = await getOtherBrands();
---

<BaseLayout
  title="showroom | featured furniture brands, boston"
  description="showroom proudly represents flexform, poliform, poltrona frau, and other leading modern furniture brands"
>
  <section class="page-intro">
    <div class="wrapper">
      <h1>Brands</h1>
      <p>
        showroom features an edited offering from some of the world<span
          class="apos">'</span
        >s most respected european lines: <a href={`/${design}/brands/flexform/`}>flexform</a
        >, <a href={`/${design}/brands/poliform/`}>poliform</a>, <a
          href={`/${design}/brands/poltrona-frau/`}>poltrona frau</a
        >, and others. reach us by phone at <a href="tel:+16174824805"
          >(617) 482-4805</a
        > or email&nbsp;
        <a href="mailto:info@showroomboston.com">info@showroomboston.com</a>.
      </p>
    </div>
  </section>

  <FeaturedBrands />
  <section class="other-brands border-top">
    <div class="wrapper">
      <h2>also proudly representing</h2>
      <ul class="other-brands-list">
        {
          otherBrands.map((brand) => (
            <li>
              <a href={`/${design}/brands/${brand.id}/`} class="caret-after">
                {brand.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
