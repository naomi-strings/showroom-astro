---
/* pre-index: lets the client choose which site design to look at */
import "../styles/showroom-styles.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>showroom | choose a design</title>
  </head>
  <body class="pre-index">
    <main class="wrapper">
      <p class="pre-index-kicker">showroom boston · design review</p>
      <ul class="pre-index-choices">
        <li><a href="/1/" class="pre-index-choice"><span>1</span><small>header band</small></a></li>
        <li><a href="/2/" class="pre-index-choice"><span>2</span><small>floating nav</small></a></li>
      </ul>
      <p class="pre-index-note">every page has a 1 | 2 switch in the top menu, so you can flip between designs anywhere.</p>
    </main>
  </body>
</html>
