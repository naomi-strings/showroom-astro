---
import { getImage } from "astro:assets";
import LogoS from "../assets/logos/logo-s.svg";
import LogoFull from "../assets/logos/logo-showroom.svg";
import heroImage from "../assets/images/home-page-hero-2.png";
import { otherDesign, stripDesign } from "../lib/design";

const { design = "1" } = Astro.params;
const path = stripDesign(Astro.url.pathname);
const isHome = path === "/";
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
const other = otherDesign(design);
const otherHref = `/${other}${path}`;

/* design 2: the hero texture becomes the header background on inner pages */
const texture = design === "2" ? await getImage({ src: heroImage, format: "webp", width: 1800 }) : null;
---
<header style={texture ? `--header-texture: url(${texture.src})` : undefined}>
  <div class="wrapper">
  <a href={`/${design}/`} class:list={["logo", { "logo-hidden": isHome }]} aria-label="Showroom home">
    <LogoS class="logo-s" width="45" height="45" aria-hidden="true" />
    <LogoFull class="logo-full" width="100" height="58" aria-hidden="true" />
  </a>

  {design === "2" && (
    <button type="button" class="menu-toggle" aria-label="menu" aria-expanded="false" aria-controls="main-nav">
      <span></span><span></span><span></span>
    </button>
  )}

  <nav aria-label="Main" id="main-nav">
    <ul class="nav-links">
      <li><a href={`/${design}/brands/`} aria-current={current("/brands")}>brands</a></li>
      <li><a href={`/${design}/press/`} aria-current={current("/press")}>press</a></li>
      <li><a href={`/${design}/contact/`} aria-current={current("/contact")}>contact</a></li>
    </ul>
  </nav>

  <a href={otherHref} class="design-switch" aria-label={`switch to design ${other}`} title={`switch to design ${other}`}>
    <span class:list={{ on: design === "1" }}>1</span><span aria-hidden="true">|</span><span class:list={{ on: design === "2" }}>2</span>
  </a>

  <button type="button" class="theme-toggle" aria-label="switch between light and dark mode">
    <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  </button>
</div>
</header>

<script>
  /* design 2 mobile menu: the hamburger opens and closes the nav */
  const btn = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const header = document.querySelector("header");
  if (btn && header) {
    btn.addEventListener("click", () => {
      const open = header.classList.toggle("menu-open");
      btn.setAttribute("aria-expanded", String(open));
    });
  }
</script>
