---
import { Image } from "astro:assets";
import { getFeaturedBrands, brandImage, brandLogo } from "../lib/brands";

const { heading } = Astro.props;
const brands = await getFeaturedBrands();
---

<section class="featured border-top" id="featured">
  <div class="wrapper">
    {heading && <h2>{heading}</h2>}
    <ul class="featured-list">
      {
        brands.map((brand) => {
          const { name, blurb, heroImage, heroImageAlt, logoWidth } = brand.data;
          const Logo = brandLogo(brand.id, "white");
          return (
            <li class="feature-card">
              <a href={`/brands/${brand.id}/`} class="feature-media" aria-label={name}>
                {heroImage && (
                  <Image
                    src={brandImage(brand.id, heroImage)}
                    alt={heroImageAlt ?? ""}
                    class="feature-bg"
                  />
                )}
                <Logo
                  class="feature-logo"
                  style={`--logo-w: ${logoWidth}`}
                  aria-hidden="true"
                />
              </a>
              <p class="feature-caption">
                <span class="feature-name">{name}</span> {blurb}{" "}
                <a href={`/brands/${brand.id}/`} class="more-link">
                  more<span class="visually-hidden"> about {name}</span>
                </a>
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
