---
import { Image } from "astro:assets";
import { getFeaturedBrands, brandImage, brandLogo } from "../lib/brands";

const { heading } = Astro.props;
const { design } = Astro.params;
const brands = await getFeaturedBrands();
---

<section class="featured border-top" id="featured">
  <div class="wrapper">
    {heading && <h2>{heading}</h2>}
    <ul class="featured-list">
      {
        brands.map((brand) => {
          const { name, blurb, heroImage, logoWidth, logoStyle } = brand.data;
          const Logo = brandLogo(brand.id, logoStyle);
          return (
            <li class="feature-card">
              {/* the photo is the link; the former caption becomes the image's alt text */}
              <a href={`/${design}/brands/${brand.id}/`} class="feature-media" aria-label={(blurb ? `${name}: ${blurb}` : name)}>
                {heroImage && (
                  <Image
                    src={brandImage(brand.id, heroImage)}
                    alt={(blurb ? `${name}: ${blurb}` : name)}
                    class="feature-bg"
                    widths={[400, 800, 1000]}
                    sizes="(min-width: 50em) 33vw, 100vw"
                  />
                )}
                {Logo && (
                  <Logo
                    class={`feature-logo logo-${logoStyle}`}
                    style={`--logo-w: ${logoWidth}`}
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
